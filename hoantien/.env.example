# Tùy chọn: nhận báo cáo qua Telegram (dùng chung channel với caffiliate/saffi).
# Copy 2 dòng này từ ../saffiliate/.env hoặc ../caffiliate/.env sang.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# KHUYẾN NGHỊ: đăng nhập cố định bằng email+mật khẩu (POST /auth/login) — bền hơn OAuth Google
# nhiều (không cần trình duyệt, chạy headless/màn hình khóa OK, tự thỏa nhiệm vụ login_day).
# Đặt mật khẩu 1 lần qua https://hoantienshopee.me/quen-mat-khau rồi điền vào đây.
HOANTIEN_EMAIL=
HOANTIEN_PASSWORD=
